# Copy to .env.local (gitignored) and fill in. Used only by scripts/content/*.
# Never add a VITE_ prefix: Vite inlines such variables into the public bundle.

# ElevenLabs — course audio (scripts/content/tts.ts)
# Key permissions: Text to Speech → Access, Voices → Read, User → Read;
# optionally Speech to Text → Access for scripts/content/stt-check.ts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_2=
# Georgian is supported by eleven_v4 and eleven_v3 (not by eleven_multilingual_v2).
ELEVENLABS_MODEL=eleven_v4

# Anthropic (Claude) — content generation scripts, from unit 5 on
ANTHROPIC_API_KEY=

# Google Gemini — pictures for new words (scripts/media-legacy), optional
GEMINI_API_KEY=
