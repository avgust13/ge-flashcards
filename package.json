{
  "name": "ge-flashcards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.scripts.json && npm run content:check && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "content": "tsx scripts/content/build.ts",
    "content:check": "tsx scripts/content/build.ts --check",
    "content:verify": "tsx scripts/content/verify-verbs.ts",
    "content:tts": "tsx --env-file=.env.local scripts/content/tts.ts",
    "content:stt": "tsx --env-file=.env.local scripts/content/stt-check.ts",
    "content:verify-lexicon": "tsx scripts/content/verify-lexicon.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "idb": "8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "styled-components": "^6.1.13",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.7"
  }
}
